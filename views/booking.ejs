<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Booking | Car Rental</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="site-header">
  <a href="/" class="brand"><span class="brand-icon">🚗</span><span>Car Rental</span></a>
  <nav class="main-nav">
    <a href="/">Home</a><a href="/cars">Cars</a><a href="/booking" class="active">Booking</a><a href="/contact">Contact</a>
    <% if (currentUser && currentUser.role === "admin") { %><a href="/dashboard">Dashboard</a><% } %>
    <a href="/logout" class="nav-button">Logout</a>
  </nav>
</header>

<main class="form-page">
  <div class="form-card">
    <div class="section-heading">
      <span>RESERVATION</span>
      <h1>Book Your Dream Car</h1>
      <p>Fill in the details below to complete your booking request.</p>
    </div>

    <form id="bookingForm" action="/booking" method="POST">
      <label>Full Name</label>
      <input type="text" name="customerName" value="<%= currentUser ? currentUser.name : '' %>" required>

      <label>Email</label>
      <input type="email" name="email" value="<%= currentUser ? currentUser.email : '' %>" required>

      <label>Phone Number</label>
      <input type="tel" id="phone" name="phone" placeholder="10 digit mobile number" maxlength="10" pattern="[0-9]{10}" required>

      <div class="form-row">
        <div><label>Pickup Date</label><input type="date" id="pickupDate" name="pickupDate" required></div>
        <div><label>Return Date</label><input type="date" id="returnDate" name="returnDate" required></div>
      </div>

      <label>Select Car</label>
      <% if (selectedCar) { %>
        <input
          type="text"
          value="<%= selectedCar.brand %> <%= selectedCar.name %> - ₹<%= selectedCar.price %>/day"
          readonly
        >
        <input
          type="hidden"
          name="carName"
          value="<%= selectedCar.name %>"
        >
      <% } else { %>
        <select name="carName" required>
          <option value="">Select Car</option>
          <% cars.forEach((car) => { %>
            <option value="<%= car.name %>">
              <%= car.brand %> <%= car.name %> - ₹<%= car.price %>/day
            </option>
          <% }) %>
        </select>
      <% } %>

      <button type="submit" class="btn btn-primary full-btn">Confirm Booking</button>
    </form>
  </div>
</main>

<footer class="site-footer">
  <div><h3>Car Rental</h3><p>Premium car rental service.</p></div>
  <div><h3>Contact</h3><p>gurpreetverma447@gmail.com</p><p>+91 8081106764</p></div>
  <div><h3>Quick Links</h3><a href="/">Home</a><a href="/cars">Cars</a><a href="/contact">Contact</a></div>
</footer>
<div class="footer-bottom">© 2026 Car Rental Booking System. All Rights Reserved.</div>
<script src="/js/script.js"></script>
</body>
</html>
