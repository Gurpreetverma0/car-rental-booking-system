<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Car Rental | Home</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="site-header">
  <a href="/" class="brand">
    <span class="brand-icon">🚗</span>
    <span>Car Rental</span>
  </a>

  <nav class="main-nav">
    <a href="/" class="active">Home</a>
    <a href="/cars">Cars</a>
    <a href="/booking">Booking</a>
    <a href="/contact">Contact</a>

    <% if (currentUser) { %>
      <% if (currentUser.role === "admin") { %>
        <a href="/dashboard">Dashboard</a>
      <% } else { %>
        <a href="/my-bookings">My Bookings</a>
      <% } %>
      <a href="/logout" class="nav-button">Logout</a>
    <% } else { %>
      <a href="/login" class="nav-button">Login</a>
    <% } %>
  </nav>
</header>

<main>
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="eyebrow">PREMIUM CAR RENTAL SERVICE</span>
      <h1>Rent Your Dream Car</h1>
      <p>Affordable, luxury and premium cars available for rent anytime.</p>

      <div class="hero-buttons">
        <a href="/cars" class="btn btn-primary">View Cars</a>
        <a href="/booking" class="btn btn-light">Book Now</a>
      </div>
    </div>
  </section>

  <section class="feature-section">
    <div class="section-heading">
      <span>WHY CHOOSE US</span>
      <h2>Everything you need for a smooth ride</h2>
    </div>

    <div class="feature-grid">
      <article class="feature-card">
        <div class="feature-icon">🚘</div>
        <h3>Premium Cars</h3>
        <p>Choose from comfortable, well-maintained cars for every journey.</p>
      </article>
      <article class="feature-card">
        <div class="feature-icon">💰</div>
        <h3>Affordable Prices</h3>
        <p>Transparent daily rental prices with no unnecessary surprises.</p>
      </article>
      <article class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Quick Booking</h3>
        <p>Pick your car and dates, then complete your booking in minutes.</p>
      </article>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div>
    <h3>Car Rental</h3>
    <p>Premium car rental service.</p>
  </div>
  <div>
    <h3>Contact</h3>
    <p>gurpreetverma447@gmail.com</p>
    <p>+91 8081106764</p>
  </div>
  <div>
    <h3>Quick Links</h3>
    <a href="/">Home</a>
    <a href="/cars">Cars</a>
    <a href="/booking">Booking</a>
  </div>
</footer>

<div class="footer-bottom">© 2026 Car Rental Booking System. All Rights Reserved.</div>

<script src="/js/script.js"></script>
</body>
</html>
