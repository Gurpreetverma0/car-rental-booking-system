<!DOCTYPE html>
<html>

<head>

    <title>Edit Car</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="login-container">

<h2>Edit Car</h2>

<form action="/cars/<%= car._id %>?_method=PUT" method="POST">

<input
type="text"
name="name"
value="<%= car.name %>"
required>

<input
type="text"
name="brand"
value="<%= car.brand %>"
required>

<input
type="number"
name="price"
value="<%= car.price %>"
required>

<input
type="text"
name="image"
value="<%= car.image %>"
required>

<button type="submit">

Update Car

</button>

</form>

</div>

</body>

</html>